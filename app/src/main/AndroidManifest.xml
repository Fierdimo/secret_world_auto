<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Desde Android 12 hay que pedir ambas: el usuario puede conceder solo COARSE. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Capa propia de Pleos: ver docs/PLEOS-SDK-SURFACE.md -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.SecretWorld"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <!-- Declara la app como app de media para el sistema de automocion. -->
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
