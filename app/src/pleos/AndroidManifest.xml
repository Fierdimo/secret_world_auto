<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      Para el emulador de Pleos: una app de coche; la voz en inglés y español y Pleos check usan
      los servicios de la plataforma (caas). Los permisos son de nivel normal y se
      conceden al instalar. Ver docs/PLEOS-SDK-SURFACE.md.
    -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- LLM_SERVICE, solo para verificarlo: antes de publicar hay que quitarlo, porque Pleos retiró su SDK
         y declarar un permiso no aprobado hace fallar la revisión. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.LLM_SERVICE" />

    <queries>
        <package android:name="ai.pleos.playground.caas" />
    </queries>

    <!--
      El escritorio de Pleos tiene dos huecos: uno grande, apaisado (1640×1400), y
      otro pequeño en vertical (800×1400). Fijada en horizontal, en el pequeño la
      plataforma la tapaba con "ensancha la ventana". Aquí cabe en los dos.
    -->
    <application>
        <activity
            android:name="com.secretworld.auto.MainActivity"
            android:screenOrientation="unspecified"
            tools:replace="android:screenOrientation" />
        <!-- Verifica TTS, STT, LLM y navegación por separado. Solo en esta variante. -->
        <activity
            android:name="com.secretworld.auto.PleosCheckActivity"
            android:exported="true"
            android:label="Pleos check"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|locale|layoutDirection|fontScale"
            android:launchMode="singleTop"
            android:taskAffinity="com.secretworld.auto.pleos.check"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
